# Copy to .env and fill in real values. Never commit .env.
# These are server-side settings only; never expose them to frontend code.

# Django
DJANGO_SECRET_KEY=replace-with-a-long-random-string
# Local development only. Leave unset (off) in production.
DJANGO_DEBUG=true
# Production: set these for the real domain (Render's onrender.com host is
# added automatically from RENDER_EXTERNAL_HOSTNAME).
# DJANGO_ALLOWED_HOSTS=shop.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
# Time zone used for scheduling (IANA name).
# DJANGO_TIME_ZONE=America/New_York

# PostgreSQL.
# Local server: the app's own role and database (see docs/DEVELOPER.md
# "Create the local database"). sslmode=disable is accepted for localhost only.
DATABASE_URL=postgresql://cleaning_app:YOUR_DB_PASSWORD@localhost:5432/cleaning_service?sslmode=disable
# Hosted (e.g. Supabase): Dashboard > Connect > Session pooler > URI. URL-encode
# special characters in the password. Never use a Supabase API key here.
# DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:5432/postgres

# Alternatively, leave DATABASE_URL unset and use individual settings:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=cleaning_service
# DB_USER=cleaning_app
# DB_PASSWORD=YOUR_DB_PASSWORD

# TLS: require (default), verify-ca, or verify-full. Weaker modes are rejected
# except for localhost.
# DB_SSLMODE=verify-full
# DB_SSLROOTCERT=/path/to/root.crt

# Seconds to keep connections open (0 closes after each request).
# DB_CONN_MAX_AGE=60

# Business details shown on the site. The defaults are placeholders.
# BUSINESS_NAME=Brightwell Home Cleaning
# BUSINESS_PHONE=(555) 010-0199
# BUSINESS_EMAIL=hello@example.com
# BUSINESS_SERVICE_AREA=Hartford County, Connecticut
# BUSINESS_HOURS=Monday to Saturday, 8 am to 6 pm
